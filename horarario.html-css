<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grade DSM</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6f9;
      padding: 20px;
    }

    h1 {
      text-align: center;
      color: #2c3e50;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
    }

    th {
      background: #34495e;
      color: white;
      padding: 15px;
    }

    td {
      border: 1px solid #ddd;
      padding: 12px;
      text-align: center;
    }

    tr:nth-child(even) {
      background: #f8f9fa;
    }

    .semestre {
      background: #3498db;
      color: white;
      font-weight: bold;
    }
  </style>
</head>

<body>

  <h1>DESENVOLVIMENTO DE SOFTWARE MULTIPLATAFORMA</h1>

  <table>
    <tr>
      <th>Semestre</th>
      <th>Horário</th>
      <th>Segunda</th>
      <th>Terça</th>
      <th>Quarta</th>
      <th>Quinta</th>
      <th>Sexta</th>
      <th>Sábado</th>
    </tr>

    <tr>
      <td class="semestre">1º</td>
      <td>08:00 - 11:30</td>
      <td>Sistemas Operacionais</td>
      <td>Banco de Dados</td>
      <td>Design Digital</td>
      <td>Algoritmos</td>
      <td>Engenharia de Software I</td>
      <td>Desenvolvimento Web I</td>
    </tr>

    <tr>
      <td class="semestre">2º</td>
      <td>08:00 - 11:30</td>
      <td>Banco de Dados Relacional</td>
      <td>Técnicas de Programação</td>
      <td>Matemática para Computação</td>
      <td>Estrutura de Dados</td>
      <td>Desenvolvimento Web II</td>
      <td>Engenharia de Software II</td>
    </tr>

    <tr>
      <td class="semestre">3º</td>
      <td>08:00 - 11:30</td>
      <td>Álgebra Linear</td>
      <td>Banco de Dados Não Relacional</td>
      <td>Desenvolvimento Web III</td>
      <td>Gestão Ágil de Projetos</td>
      <td>Técnicas de Programação II</td>
      <td>Inglês</td>
    </tr>

    <tr>
      <td class="semestre">4º</td>
      <td>08:00 - 11:30</td>
      <td>-</td>
      <td>Banco de Dados</td>
      <td>Design Digital</td>
      <td>Algoritmos</td>
      <td>Engenharia de Software</td>
      <td>Desenvolvimento Web</td>
    </tr>

    <tr>
      <td class="semestre">5º</td>
      <td>08:00 - 11:30</td>
      <td>Sistemas Operacionais</td>
      <td>Banco de Dados</td>
      <td>Design Digital</td>
      <td>Algoritmos</td>
      <td>Engenharia de Software</td>
      <td>Desenvolvimento Web</td>
    </tr>

    <tr>
      <td class="semestre">6º</td>
      <td>08:00 - 11:30</td>
      <td>Sistemas Operacionais</td>
      <td>Banco de Dados</td>
      <td>Design Digital</td>
      <td>Algoritmos</td>
      <td>Engenharia de Software</td>
      <td>Desenvolvimento Web</td>
    </tr>
  </table>

</body>

</html>
