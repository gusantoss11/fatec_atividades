<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tabela Brasileirão</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family: Arial, sans-serif;
    background:#f4f4f4;
    padding:20px;
}

h1{
    text-align:center;
    margin-bottom:20px;
    color:#006437;
}

table{
    width:100%;
    border-collapse:collapse;
    background:white;
    box-shadow:0 0 10px rgba(0,0,0,0.2);
}

th{
    background:#006437;
    color:white;
    padding:12px;
    font-size:15px;
}

td{
    border:1px solid #ddd;
    padding:10px;
    text-align:center;
}

tr:nth-child(even){
    background:#f8f8f8;
}

tr:hover{
    background:#e8f5e9;
}

img{
    width:35px;
    height:35px;
}

.time{
    text-align:left;
    font-weight:bold;
}

.ultimos{
    font-size:18px;
}

</style>
</head>
<body>

<h1>🏆 Campeonato Brasileiro Série A</h1>

<table>

<tr>
    <th>Pos</th>
    <th>Escudo</th>
    <th>Time</th>
    <th>PJ</th>
    <th>V</th>
    <th>E</th>
    <th>D</th>
    <th>GP</th>
    <th>GA</th>
    <th>DG</th>
    <th>PTS</th>
    <th>Últimos 5</th>
</tr>

<tr>
    <td>1</td>
    <td><img src="img/palmeiras.png.png"></td>
